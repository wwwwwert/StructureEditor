/* Structure Editor — dark Material theme.
   Colors follow Material Design Dark: near-black surfaces, high-emphasis text,
   and a muted violet accent (#bb86fc). The application palette (app.py) fills
   any QSS gaps so no widget is left with a system white background. */

* {
    outline: none;
    font-family: "-apple-system", "SF Pro Text", "Segoe UI", "Helvetica Neue",
        "Ubuntu", "Inter", sans-serif;
    font-size: 13px;
}

QWidget {
    background-color: #1e222b;
    color: #e6e9ef;
}

/* ======================== Surfaces ======================== */
QMainWindow,
QDialog,
QMessageBox {
    background-color: #1e222b;
}

/* ======================== Menu bar ======================== */
QMenuBar {
    background-color: #171a21;
    border-bottom: 1px solid #262c38;
    padding: 3px 8px;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 6px;
}
QMenuBar::item:selected {
    background: #2c3340;
}
QMenuBar::item:pressed {
    background: #2c3340;
}

QMenu {
    background-color: #232936;
    border: 1px solid #2e3646;
    border-radius: 8px;
    padding: 6px;
}
QMenu::item {
    padding: 6px 28px 6px 16px;
    border-radius: 5px;
}
QMenu::item:selected {
    background: #2c3340;
    color: #ffffff;
}
QMenu::item:disabled {
    color: #6a7280;
}
QMenu::separator {
    height: 1px;
    background: #2e3646;
    margin: 6px 10px;
}

/* ======================== Toolbar ======================== */
QToolBar {
    background-color: #171a21;
    border: none;
    border-bottom: 1px solid #262c38;
    spacing: 4px;
    padding: 6px;
}
QToolBar::separator {
    width: 1px;
    background: #2e3646;
    margin: 4px 8px;
}

QToolButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 5px 8px;
    color: #c6cdda;
}
QToolButton:hover {
    background: #2c3340;
}
QToolButton:pressed {
    background: #343d4d;
}
QToolButton:checked {
    background: rgba(187, 134, 252, 0.18);
    color: #d8c9ff;
}
QToolButton:checked:hover {
    background: rgba(187, 134, 252, 0.26);
}
QToolButton:disabled {
    color: #6a7280;
}
QToolButton::menu-indicator {
    image: none;
}

/* ======================== Tabs ======================== */
QTabWidget::pane {
    border: 1px solid #1e222b;
    background-color: #1e222b;
}

/* Give the whole tab strip an opaque dark background so no native style can
   paint it light. Tabs themselves also use opaque fills for every state. */
QTabBar {
    background: #1e222b;
}
QTabBar::tab:top {
    margin-top: 6px;
}
QTabBar::tab {
    background: #262c38;
    color: #9aa3b2;
    padding: 8px 22px;
    border: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 2px;
    font-weight: 600;
}
QTabBar::tab:selected {
    background: #1e222b;
    color: #ffffff;
}
QTabBar::tab:hover:!selected {
    background: #2c3340;
    color: #dfe5ee;
}
QTabBar::tab:disabled {
    background: #1e222b;
    color: #6a7280;
}

/* ======================== Buttons ======================== */
QPushButton {
    background-color: #2c3340;
    border: 1px solid #39424f;
    border-radius: 8px;
    padding: 9px 18px;
    font-weight: 600;
    color: #e6e9ef;
}
QPushButton:hover {
    background-color: #343d4d;
    border-color: #45505f;
}
QPushButton:pressed {
    background-color: #232a36;
}
QPushButton:disabled {
    background-color: #20242d;
    color: #6a7280;
    border-color: #2a313e;
}
QPushButton:focus {
    border: 1px solid #bb86fc;
}
QPushButton#primary {
    background-color: #bb86fc;
    border: 1px solid #bb86fc;
    color: #121212;
}
QPushButton#primary:hover {
    background-color: #c99cfd;
}

/* ======================== Inputs ======================== */
QLabel {
    background: transparent;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: #262c38;
    border: 1px solid #333c4d;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #bb86fc;
    selection-color: #121212;
}
QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #bb86fc;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background-color: #232936;
    border: 1px solid #2e3646;
    padding: 4px;
    selection-background-color: #2c3340;
    selection-color: #ffffff;
}

/* ======================== Table ======================== */
QTableWidget,
QTableView {
    background-color: #1e222b;
    alternate-background-color: #232a36;
    gridline-color: #2a313e;
    border: 1px solid #2e3646;
    border-radius: 8px;
    selection-background-color: rgba(187, 134, 252, 0.24);
    selection-color: #ffffff;
}
QHeaderView::section {
    background-color: #232a36;
    color: #aab3c0;
    border: none;
    border-bottom: 1px solid #2e3646;
    border-right: 1px solid #262c38;
    padding: 8px;
    font-weight: 700;
}
QHeaderView::section:last {
    border-right: none;
}
QTableCornerButton::section {
    background-color: #232a36;
    border: none;
}
QTableView::item:selected {
    background-color: rgba(187, 134, 252, 0.24);
}

/* ======================== Scroll bars ======================== */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #3a4252;
    border-radius: 6px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #4a5365;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #3a4252;
    border-radius: 6px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #4a5365;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ======================== Splitter ======================== */
QSplitter::handle {
    background: #262c38;
}
QSplitter::handle:hover {
    background: #bb86fc;
}
QSplitter::handle:horizontal {
    width: 2px;
}
QSplitter::handle:vertical {
    height: 2px;
}

/* ======================== Status bar ======================== */
QStatusBar {
    background-color: #171a21;
    border-top: 1px solid #262c38;
    color: #9aa3b2;
}
QStatusBar::item {
    border: none;
}

/* ======================== Tooltips ======================== */
QToolTip {
    background-color: #2c3340;
    color: #e6e9ef;
    border: 1px solid #39424f;
    border-radius: 6px;
    padding: 5px 8px;
}

/* ======================== Canvas (graphics view) ======================== */
QGraphicsView {
    background-color: #10131a;
    border: 1px solid #262c38;
    border-radius: 10px;
}

/* ======================== Dialogs ======================== */
QDialogButtonBox QPushButton {
    min-width: 84px;
}