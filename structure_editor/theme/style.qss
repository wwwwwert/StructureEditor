/* Structure Editor — modern dark theme */

* {
    outline: none;
}

QWidget {
    background-color: #1e222b;
    color: #e6e9ef;
    font-family: "Inter", "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #1e222b;
}

QWidget#central {
    background-color: #1e222b;
}

/* Big content area behind canvases / plot */
QWidget#contentArea {
    background-color: #161a22;
    border-radius: 10px;
}

/* ---------- Menu bar ---------- */
QMenuBar {
    background-color: #171a21;
    border-bottom: 1px solid #262c38;
    padding: 2px 6px;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 6px;
}
QMenuBar::item:selected {
    background: #2c3340;
}

QMenu {
    background-color: #232936;
    border: 1px solid #2e3646;
    border-radius: 8px;
    padding: 6px;
}
QMenu::item {
    padding: 6px 26px 6px 14px;
    border-radius: 5px;
}
QMenu::item:selected {
    background: #3b78ff;
    color: #ffffff;
}
QMenu::separator {
    height: 1px;
    background: #2e3646;
    margin: 4px 8px;
}

/* ---------- Toolbar ---------- */
QToolBar {
    background-color: #171a21;
    border: none;
    border-bottom: 1px solid #262c38;
    spacing: 4px;
    padding: 4px;
}
QToolBar::separator {
    width: 1px;
    background: #2e3646;
    margin: 4px 6px;
}
QToolButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 6px 8px;
}
QToolButton:hover {
    background: #2c3340;
}
QToolButton:pressed,
QToolButton:checked {
    background: #3b78ff;
    color: #ffffff;
}
QToolButton::menu-indicator {
    image: none;
}

/* ---------- Tabs ---------- */
QTabWidget::pane {
    border: none;
    top: -1px;
}
QTabBar::tab {
    background: #171a21;
    color: #9aa3b2;
    padding: 8px 18px;
    border: 1px solid transparent;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 2px;
    font-weight: 600;
}
QTabBar::tab:hover {
    color: #dfe5ee;
}
QTabBar::tab:selected {
    background: #1e222b;
    color: #ffffff;
    border-color: #262c38;
}

/* ---------- Push buttons ---------- */
QPushButton {
    background-color: #2c3340;
    border: 1px solid #39424f;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #343d4d;
}
QPushButton:pressed {
    background-color: #232a36;
}
QPushButton:disabled {
    background-color: #20242d;
    color: #6a7280;
}
QPushButton#primary {
    background-color: #3b78ff;
    border: 1px solid #4a85ff;
}
QPushButton#primary:hover {
    background-color: #4a85ff;
}

/* ---------- Labels / inputs ---------- */
QLabel {
    background: transparent;
}
QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: #262c38;
    border: 1px solid #333c4d;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #3b78ff;
}
QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #3b78ff;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox QAbstractItemView {
    background-color: #232936;
    border: 1px solid #2e3646;
    padding: 4px;
    selection-background-color: #3b78ff;
}

/* ---------- Table / tree ---------- */
QTableWidget,
QTableView {
    background-color: #1e222b;
    alternate-background-color: #232a36;
    gridline-color: #2a313e;
    border: 1px solid #2e3646;
    border-radius: 8px;
}
QHeaderView::section {
    background-color: #232a36;
    color: #aab3c0;
    border: none;
    border-bottom: 1px solid #2e3646;
    padding: 8px;
    font-weight: 700;
}
QTableCornerButton::section {
    background-color: #232a36;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #3a4252;
    border-radius: 6px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #4a5365;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #3a4252;
    border-radius: 6px;
    min-width: 30px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------- Status bar ---------- */
QStatusBar {
    background-color: #171a21;
    border-top: 1px solid #262c38;
    color: #9aa3b2;
}
QStatusBar::item {
    border: none;
}

/* ---------- Graphics view (canvas) ---------- */
QGraphicsView {
    background-color: #10131a;
    border: 1px solid #262c38;
    border-radius: 8px;
}

/* ---------- Message box / dialogs ---------- */
QMessageBox {
    background-color: #1e222b;
}
QDialog {
    background-color: #1e222b;
}